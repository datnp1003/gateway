{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexFormat": "gateway-logs-{0:yyyy.MM}",
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "EnglishLearning.Auth",
    "Audience": "EnglishLearning.Gateway",
    "Secret": "PLACEHOLDER_KEY_AT_LEAST_32_CHARS_LONG_CHANGE_IN_ENV"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-api": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "learning-api": {
        "ClusterId": "learning-cluster",
        "Match": {
          "Path": "/api/learning/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/learning" }
        ],
        "AuthorizationPolicy": "Authenticated"
      },
      "ai-api": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ai" }
        ],
        "AuthorizationPolicy": "Authenticated"
      },
      "writing-api": {
        "ClusterId": "writing-cluster",
        "Match": {
          "Path": "/api/writing/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/writing" }
        ],
        "AuthorizationPolicy": "Authenticated"
      },
      "speaking-api": {
        "ClusterId": "speaking-cluster",
        "Match": {
          "Path": "/api/speaking/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/speaking" }
        ],
        "AuthorizationPolicy": "Authenticated"
      },
      "gamification-api": {
        "ClusterId": "gamification-cluster",
        "Match": {
          "Path": "/api/gamification/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/gamification" }
        ],
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5100/"
          }
        }
      },
      "learning-cluster": {
        "Destinations": {
          "learning-service": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-service": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "writing-cluster": {
        "Destinations": {
          "writing-service": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "speaking-cluster": {
        "Destinations": {
          "speaking-service": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "gamification-cluster": {
        "Destinations": {
          "gamification-service": {
            "Address": "http://localhost:5105/"
          }
        }
      }
    }
  }
}
